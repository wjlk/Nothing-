<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="92dp"
        android:contentDescription="@string/button_image_description"
        android:scaleType="centerInside"
        android:src="@drawable/button_image" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sender_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/local_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#BDBDBD"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/receiver_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:hint="@string/receiver_ip_hint"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#9E9E9E" />

    <Button
        android:id="@+id/save_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_ip"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/alert_button"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/red_call_button"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/call_button"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/ready"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
</LinearLayout>