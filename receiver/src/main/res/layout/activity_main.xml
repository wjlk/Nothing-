<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3EE"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="92dp"
        android:contentDescription="@string/button_image_description"
        android:scaleType="centerInside"
        android:src="@drawable/button_image" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/receiver_title"
        android:textColor="#151515"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/local_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#3D3A35"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/server_help"
        android:textColor="#3D3A35"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/sender_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sender_ip_hint"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="#151515"
        android:textColorHint="#77736C" />

    <Button
        android:id="@+id/save_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_ip"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/test_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/test_alarm"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/server_starting"
        android:textColor="#151515"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>